name: Code security

on:
  pull_request:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: astral-sh/setup-uv@v6
        with:
          version: '0.11.28'
          enable-cache: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - name: Install pinned scanners
        run: python3 .security/setup.py
      - name: Scan all reachable history
        run: .security/run history
